# Copy to .env.local for development. On Netlify, set these as environment variables.
# Never commit .env.local.

# Supabase project (Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Used for creating accounts, banning deactivated users and
# resetting authenticators. Must never be prefixed NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this app, used in invite emails. No trailing slash.
APP_URL=http://localhost:3000
